# Copy to .env (gitignored) and fill per-machine values.
# TOML configs reference these via ${VAR:-default}; unset falls back to the
# safe default baked into the config (localhost / current dir).

# Ollama judge host (session + gnomon eval configs). Default: http://localhost:11434
GNOMON_JUDGE_BASE_URL=

# Target repo the chateval harness drives (config/chat.toml cwd). Default: .
CHATEVAL_TARGET_CWD=

# Repo audited by scripts/audit_hallucination_severity.py. Default: .
LINA_REPO=

# Judge provider API keys (read by name via config api_key_env)
CEREBRAS_API_KEY=
DEEPINFRA_API_KEY=
